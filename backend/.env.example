PORT=5000
MONGO_URI=mongodb://localhost:27017/lockandkey
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRES_IN=7d

# ImageKit — get from https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=public_xxx
IMAGEKIT_PRIVATE_KEY=private_xxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# CORS
CORS_ORIGIN=http://localhost:5173

# Webhook — HMAC SHA256 secret for INCOMING webhooks
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Inbound: sender signs raw JSON body with secret → X-Signature header
# Outbound: each subscription gets its own per-webhook secret stored in DB (Webhook.secret)
WEBHOOK_SECRET=change_me_generate_with_crypto_randomBytes_32_hex

# Seed admin (optional)
SEED_ADMIN_EMAIL=admin@lockkey.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Default Admin
